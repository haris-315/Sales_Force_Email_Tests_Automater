{
  "manifest_version": 3,
  "name": "Salesforce Email CSV Autofill",
  "version": "1.0.0",
  "description": "Iterate through CSV rows and autofill Salesforce Lightning Email Composer (Receiver, Subject, Content, and Send).",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.force.com/*",
    "*://*.salesforce.com/*",
    "*://*.my.salesforce.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Salesforce Email CSV Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.force.com/*",
        "*://*.salesforce.com/*",
        "*://*.my.salesforce.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
